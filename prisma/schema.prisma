generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model DailyPuzzle {
  id           String   @id @default(cuid())
  date         String   // Format: YYYY-MM-DD
  difficulty   String   // "easy" or "hard"
  startWord    String
  wordSequence Json     // Array of words in the ladder
  clues        Json     // Array of clues for each transformation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, difficulty])
  @@map("daily_puzzles")
}

model GameSession {
  id            String   @id @default(cuid())
  puzzleId      String
  currentStep   Int      @default(0)
  hintsUsed     Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("game_sessions")
}
